# Copie para .env — variáveis de ambiente vencem flow.toml.
# DATABASE_URL=postgresql://flow:flow@localhost:5432/flow   # somente PostgreSQL (PostgreSQL nativo; veja o README)
# FLOW_DEFAULT_PROVIDER=ollama
# FLOW_DEFAULT_MODEL=gemma3:4b
# OLLAMA_BASE_URL=http://localhost:11434
# FLOW_PUBLIC_URL=http://localhost:5000
# A2A_BEARER_TOKEN=troque-isto      # protege /a2a/*
# FLOW_API_TOKEN=troque-isto        # protege /api/*; no navegador: localStorage.flowApiToken = "troque-isto"
# SECRET_KEY=troque-isto
# FLOW_GIT_ENABLED=true
# FLOW_CD_ENABLED=true
# FLOW_CD_AUTO_DEPLOY=false          # true = sobe sem aprovação humana (NÃO recomendado)
# FLOW_EMBEDDED_WORKER=true            # false = rode `flask --app flow worker` à parte
# FLOW_WORKER_CONCURRENCY=4
